  "description": "Release tooling only (semantic-release). The OpenTofu modules do not depend on Node.",
  "license": "MIT",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
